local function TeleportToIsland(islandName)
    local pos = GameData.Islands[islandName]
    if not pos then
        Notify("Teleport", "Không tìm thấy đảo: " .. tostring(islandName), 2)
        return
    end
    Runtime.IsTeleporting = true
    SetStatus("Đang dịch chuyển tới: " .. islandName)
    Notify("Teleport", "Đang bay tới " .. islandName .. "...", 3)
    SmoothTweenTo(CFrame.new(pos), function()
        Runtime.IsTeleporting = false
        SetStatus("Đã tới " .. islandName)
        Notify("Teleport", "Đã đến " .. islandName .. "!", 2)
    end)
end


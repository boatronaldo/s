local function RefreshESP()
    if not (Config.ESPPlayers or Config.ESPMobs or Config.ESPFruits) then
        ClearAllESP()
        return
    end

    local myRoot = Runtime.RootPart
    if not myRoot then return end

    local activeTargets = {}

    local function ProcessTarget(keyObj, part, nameStr, hum, color)
        if not part then return end
        activeTargets[keyObj] = true
        local dist = math.floor((myRoot.Position - part.Position).Magnitude)
        local hpText = ""
        if hum and hum.MaxHealth > 0 then
            hpText = string.format(" [%d%%]", math.floor((hum.Health / hum.MaxHealth) * 100))
        end
        local display = string.format("%s%s\n[%dm]", nameStr, hpText, dist)

        local badge = Runtime.ESPItems[keyObj]
        if not badge or not badge.Parent then
            badge = CreateESPBadge(part, display, color)
            Runtime.ESPItems[keyObj] = badge
        else
            local lbl = badge:FindFirstChild("InfoLabel")
            if lbl then
                lbl.Text = display
                lbl.TextColor3 = color
            end
        end
    end

    -- 1. Player ESP
    if Config.ESPPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local pRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                local pHum = plr.Character:FindFirstChildOfClass("Humanoid")
                if pRoot and pHum and pHum.Health > 0 then
                    ProcessTarget(plr.Character, pRoot, "⚡ " .. plr.Name, pHum, Color3.fromRGB(0, 230, 255))
                end
            end
        end
    end

    -- 2. Mob ESP
    if Config.ESPMobs then
        local eFolder = Workspace:FindFirstChild("Enemies") or Workspace
        for _, mob in ipairs(eFolder:GetChildren()) do
            if mob:IsA("Model") and mob ~= Runtime.Character and not Players:GetPlayerFromCharacter(mob) then
                local mRoot = mob:FindFirstChild("HumanoidRootPart")
                local mHum = mob:FindFirstChildOfClass("Humanoid")
                if mRoot and mHum and mHum.Health > 0 then
                    ProcessTarget(mob, mRoot, "⚔ " .. mob.Name, mHum, Color3.fromRGB(255, 95, 110))
                end
            end
        end
    end

    -- 3. Fruit / Tool ESP
    if Config.ESPFruits then
        for _, item in ipairs(Workspace:GetChildren()) do
            if item:IsA("Tool") or item.Name:lower():find("fruit") then
                local handle = item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart")
                if handle then
                    ProcessTarget(item, handle, "🍎 " .. item.Name, nil, Color3.fromRGB(255, 215, 0))
                end
            end
        end
    end

    -- Dọn dẹp đối tượng đã biến mất hoặc tắt toggle
    for obj, badge in pairs(Runtime.ESPItems) do
        if not activeTargets[obj] or not obj.Parent then
            if badge then badge:Destroy() end
            Runtime.ESPItems[obj] = nil
        end
    end
end


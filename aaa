-- ================== 5. CORE HELPERS (MOVEMENT, COMBAT, REMOTES) ==================
local function GetCommRemote()
    local remFolder = ReplicatedStorage:FindFirstChild("Remotes")
    if remFolder and remFolder:FindFirstChild("CommF_") then
        return remFolder.CommF_
    end
    return ReplicatedStorage:FindFirstChild("CommF_")
end

local function InvokeComm(...)
    local remote = GetCommRemote()
    if remote and remote:IsA("RemoteFunction") then
        local ok, res = pcall(remote.InvokeServer, remote, ...)
        if ok then return res end
    end
    return nil
end

local function CancelActiveTween()
    if Runtime.ActiveTween then
        pcall(function() Runtime.ActiveTween:Cancel() end)
        Runtime.ActiveTween = nil
    end
    Runtime.IsTeleporting = false
end

local function SmoothTweenTo(targetCFrame, onComplete)
    local root = Runtime.RootPart
    local hum = Runtime.Humanoid
    if not root or not hum or hum.Health <= 0 then return end

    local dist = (root.Position - targetCFrame.Position).Magnitude
    if dist <= 12 then
        CancelActiveTween()
        root.CFrame = targetCFrame
        if onComplete then onComplete() end
        return
    end

    if Runtime.ActiveTween then
        pcall(function() Runtime.ActiveTween:Cancel() end)
    end

    -- Nếu khoảng cách gần (< 45 studs), đặt trực tiếp để bám mục tiêu nhanh
    if dist < 45 and not Runtime.IsTeleporting then
        root.CFrame = targetCFrame
        if onComplete then onComplete() end
        return
    end

    local duration = math.clamp(dist / Config.TweenSpeed, 0.08, 12)
    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    Runtime.ActiveTween = tween
    tween:Play()

    if onComplete then
        local conn
        conn = tween.Completed:Connect(function(state)
            conn:Disconnect()
            if state == Enum.PlaybackState.Completed then
                onComplete()
            end
        end)
    end
end

local function GetPlayerLevel()
    local data = LocalPlayer:FindFirstChild("Data")
    local lv = data and data:FindFirstChild("Level")
    return (lv and lv.Value) or 1
end

local function GetBestQuestForLevel()
    local myLv = GetPlayerLevel()
    local chosen = GameData.Quests[1]
    for _, q in ipairs(GameData.Quests) do
        if myLv >= q.MinLv then
            chosen = q
        end
    end
    return chosen
end

local function IsQuestActive()
    local mainGui = PlayerGui:FindFirstChild("Main")
    local questFrame = mainGui and mainGui:FindFirstChild("Quest")
    return questFrame and questFrame.Visible == true
end

-- Quét quái đa tầng (Ưu tiên Workspace.Enemies -> Quét toàn bộ Workspace nếu game cấu trúc khác)
local function FindTargetEnemy(preferredName, maxDistance)
    local root = Runtime.RootPart
    if not root then return nil end

    local maxDist = maxDistance or Config.FarmRadius
    local bestEnemy = nil
    local shortest = maxDist

    local function ScanContainer(folder, filterByName)
        if not folder then return end
        for _, obj in ipairs(folder:GetChildren()) do
            if obj:IsA("Model") and obj ~= Runtime.Character and not Players:GetPlayerFromCharacter(obj) then
                local eHum = obj:FindFirstChildOfClass("Humanoid")
                local eRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj.PrimaryPart
                if eHum and eRoot and eHum.Health > 0 then
                    local nameMatch = (not filterByName) or (obj.Name:lower():find(filterByName:lower(), 1, true) ~= nil)
                    if nameMatch then
                        local d = (root.Position - eRoot.Position).Magnitude
                        if d < shortest then
                            shortest = d
                            bestEnemy = obj
                        end
                    end
                end
            end
        end
    end

    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        if preferredName then
            ScanContainer(enemiesFolder, preferredName)
        end
        if not bestEnemy then
            ScanContainer(enemiesFolder, nil)
        end
    end

    -- Fallback: quét trực tiếp trong Workspace nếu folder Enemies trống hoặc khác tên
    if not bestEnemy then
        ScanContainer(Workspace, preferredName)
        if not bestEnemy then
            ScanContainer(Workspace, nil)
        end
    end

    return bestEnemy
end

local function EquipWeapon()
    local char = Runtime.Character
    local hum = Runtime.Humanoid
    if not char or not hum then return nil end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then return currentTool end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return nil end

    local priority = Config.StatPriority:lower()
    if priority == "demon fruit" then priority = "fruit" end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local tip = tostring(tool.ToolTip or ""):lower()
            local tName = tool.Name:lower()
            if tip:find(priority, 1, true) or tName:find(priority, 1, true) then
                hum:EquipTool(tool)
                return tool
            end
        end
    end

    local fallbackTool = backpack:FindFirstChildOfClass("Tool")
    if fallbackTool then
        hum:EquipTool(fallbackTool)
        return fallbackTool
    end
    return nil
end

local function PullNearbyMobs(centerPos, targetName)
    if not Config.BringMobs then return end
    local enemiesFolder = Workspace:FindFirstChild("Enemies") or Workspace
    for _, mob in ipairs(enemiesFolder:GetChildren()) do
        if mob:IsA("Model") and mob ~= Runtime.Character and not Players:GetPlayerFromCharacter(mob) then
            local eHum = mob:FindFirstChildOfClass("Humanoid")
            local eRoot = mob:FindFirstChild("HumanoidRootPart")
            if eHum and eRoot and eHum.Health > 0 then
                if (not targetName) or (mob.Name == targetName) then
                    local dist = (eRoot.Position - centerPos).Magnitude
                    if dist <= 180 then
                        pcall(function()
                            eRoot.CFrame = CFrame.new(centerPos)
                            eRoot.CanCollide = false
                            eRoot.Size = Vector3.new(45, 45, 45)
                            eRoot.Transparency = 0.85
                            if eHum:FindFirstChild("Animator") then
                                eHum.Animator:Destroy()
                            end
                        end)
                    end
                end
            end
        end
    end
end

local function PerformAttack(enemy)
    local root = Runtime.RootPart
    if not root or not enemy then return end
    local eRoot = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
    if not eRoot then return end

    local tool = EquipWeapon()

    -- Giữ vị trí phía trên đầu mục tiêu và hướng mặt xuống mục tiêu
    local hoverPos = eRoot.Position + Vector3.new(0, Config.HoverHeight, 0)
    SmoothTweenTo(CFrame.new(hoverPos, eRoot.Position))

    -- Gom quái cùng loại lại dưới chân
    PullNearbyMobs(eRoot.Position, enemy.Name)

    -- Mở rộng hitbox của mục tiêu hiện tại
    pcall(function()
        eRoot.Size = Vector3.new(45, 45, 45)
        eRoot.CanCollide = false
        eRoot.Transparency = 0.85
    end)

    -- Kích hoạt đòn đánh qua cả 3 tầng
    if tool then
        pcall(function() tool:Activate() end)
    end
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new(500, 500))
    end)
    -- Thử kích hoạt Combat Remote của Blox Fruits nếu tồn tại
    pcall(function()
        local rigEvent = ReplicatedStorage:FindFirstChild("RigControllerEvent")
        if rigEvent and rigEvent:IsA("RemoteEvent") then
            rigEvent:FireServer("weaponChange", tostring(tool and tool.Name or ""))
            rigEvent:FireServer("hit", {eRoot}, 1, "")
        end
    end)
end

-- ================== 6. AUXILIARY FEATURES ==================
local function RunAutoFarmStep()
    if not Config.AutoFarm then return end
    local root = Runtime.RootPart
    if not root then return end

    local targetMobName = nil
    if Config.AutoQuest then
        local questInfo = GetBestQuestForLevel()
        if questInfo then
            targetMobName = questInfo.Mob
            if not IsQuestActive() and GetCommRemote() then
                local distToNPC = (root.Position - questInfo.NPCPos).Magnitude
                if distToNPC > 20 then
                    SetStatus("Bay tới NPC nhận Quest: " .. questInfo.QuestName)
                    SmoothTweenTo(CFrame.new(questInfo.NPCPos + Vector3.new(0, 5, 0)))
                    return
                else
                    InvokeComm("StartQuest", questInfo.QuestName, questInfo.QuestLv)
                end
            end
        end
    end

    local enemy = FindTargetEnemy(targetMobName, Config.FarmRadius)
    if enemy then
        local eRoot = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
        if eRoot then
            local dist = (root.Position - eRoot.Position).Magnitude
            if dist > 35 then
                SetStatus(string.format("Bay tới [%s] (%dm)", enemy.Name, math.floor(dist)))
                SmoothTweenTo(CFrame.new(eRoot.Position + Vector3.new(0, Config.HoverHeight, 0)))
            else
                SetStatus(string.format("Đang đánh [%s] (HP: %d)", enemy.Name, math.floor(enemy.Humanoid.Health)))
                PerformAttack(enemy)
            end
        end
    else
        SetStatus("Đang quét tìm quái quanh bản đồ...")
    end
end


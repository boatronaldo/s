-- 2. HÀM TÌM MỤC TIÊU CHUNG (Dùng cho CamLock & Aimbot Skill)
-- ==========================================
local function getTargetRoot(player: Player): BasePart?
	local char = player.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Tìm người chơi gần tâm màn hình (chuột) nhất
local function getClosestPlayerToCursor(maxRange: number): Player?
	local mousePos = UserInputService:GetMouseLocation()
	local myRoot = getTargetRoot(localPlayer)
	local closestPlayer: Player? = nil
	local shortestScreenDist = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			local targetRoot = getTargetRoot(player)
			if targetRoot then
				-- Kiểm tra khoảng cách thực tế nếu có yêu cầu
				if myRoot and maxRange > 0 and (myRoot.Position - targetRoot.Position).Magnitude > maxRange then
					continue
				end

				local screenPos, onScreen = camera:WorldToViewportPoint(targetRoot.Position)
				if onScreen then
					local distFromCursor = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
					if distFromCursor < shortestScreenDist then
						shortestScreenDist = distFromCursor
						closestPlayer = player
					end
				end
			end
		end
	end

	return closestPlayer
end


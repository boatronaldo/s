-- Hàm tiện ích tạo nút Toggle
local function createToggleButton(text: string, order: number, callback: (boolean) -> ()): TextButton
	local btn = Instance.new("TextButton")
	btn.LayoutOrder = order
	btn.Size = UDim2.new(1, 0, 0, 38)
	btn.BackgroundColor3 = Color3.fromRGB(38, 42, 52)
	btn.Text = `{text}: TẮT`
	btn.TextColor3 = Color3.fromRGB(220, 220, 220)
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 13
	btn.Parent = container
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	local isOn = false
	btn.Activated:Connect(function()
		isOn = not isOn
		if isOn then
			btn.BackgroundColor3 = Color3.fromRGB(46, 160, 95)
			btn.Text = `{text}: BẬT`
		else
			btn.BackgroundColor3 = Color3.fromRGB(38, 42, 52)
			btn.Text = `{text}: TẮT`
		end
		callback(isOn)
	end)

	return btn
end


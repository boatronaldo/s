-- 5. XỬ LÝ PHÍM TẮT & ĐÓNG MỞ MENU
-- ==========================================
local function toggleMenu()
	state.menuVisible = not state.menuVisible
	mainFrame.Visible = state.menuVisible
end

closeBtn.Activated:Connect(toggleMenu)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	-- Ẩn/hiện bảng Admin
	if input.KeyCode == CONFIG.MENU_TOGGLE_KEY then
		toggleMenu()
		return
	end

	-- Bật/tắt khóa mục tiêu CamLock bằng phím Q
	if input.KeyCode == CONFIG.CAMLOCK_KEY and state.camLockEnabled then
		if state.camLockTarget then
			state.camLockTarget = nil
		else
			state.camLockTarget = getClosestPlayerToCursor(0)
		end
	end

	-- Aimbot Skill: Khi bấm chuột trái hoặc phím dùng skill (Z, X, C, V), tự xoay hướng về mục tiêu gần nhất
	if state.aimbotSkillEnabled then
		local isSkillInput = input.UserInputType == Enum.UserInputType.MouseButton1
			or input.KeyCode == Enum.KeyCode.Z
			or input.KeyCode == Enum.KeyCode.X
			or input.KeyCode == Enum.KeyCode.C
			or input.KeyCode == Enum.KeyCode.V

		if isSkillInput then
			local target = state.camLockTarget or getClosestPlayerToCursor(CONFIG.AIMBOT_SKILL_RANGE)
			local targetRoot = target and getTargetRoot(target)
			local myRoot = getTargetRoot(localPlayer)

			if targetRoot and myRoot then
				-- Lưu vị trí mục tiêu vào Attribute để script Skill trong game của bạn có thể đọc
				localPlayer:SetAttribute("AdminAimTargetPos", targetRoot.Position)

				-- Xoay mặt nhân vật về phía mục tiêu (giữ nguyên độ cao Y để không bị nghiêng người)
				local lookAtPos = Vector3.new(targetRoot.Position.X, myRoot.Position.Y, targetRoot.Position.Z)
				myRoot.CFrame = CFrame.lookAt(myRoot.Position, lookAtPos)
			end
		end
	end
end)

-- ==========================================
-- 6. VÒNG LẶP RENDER (CamLock & Tween Speed)
-- ==========================================
local activeTween: Tween? = nil

RunService.RenderStepped:Connect(function(dt: number)
	-- A. Xử lý CamLock mượt
	if state.camLockEnabled and state.camLockTarget then
		local targetRoot = getTargetRoot(state.camLockTarget)
		if targetRoot then
			local desiredCFrame = CFrame.lookAt(camera.CFrame.Position, targetRoot.Position)
			camera.CFrame = camera.CFrame:Lerp(desiredCFrame, CONFIG.CAMLOCK_SMOOTHNESS)
		else
			-- Mục tiêu đã chết -> nhả khóa
			state.camLockTarget = nil
		end
	end

	-- B. Xử lý Tween Speed khi nhân vật đang di chuyển
	if state.tweenSpeedEnabled then
		local char = localPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		if root and hum and hum.Health > 0 and hum.MoveDirection.Magnitude > 0.05 then
			local moveDir = hum.MoveDirection.Unit
			local stepDistance = CONFIG.TWEEN_SPEED * dt
			local targetCFrame = root.CFrame + (moveDir * stepDistance)

			if activeTween then
				activeTween:Cancel()
			end
			activeTween = TweenService:Create(
				root,
				TweenInfo.new(dt, Enum.EasingStyle.Linear),
				{ CFrame = targetCFrame }
			)
			activeTween:Play()
		end
	end
end)

-- Cập nhật khoảng cách ESP mỗi 0.1s (tối ưu hiệu năng)
task.spawn(function()
	while true do
		task.wait(0.1)
		if not state.espEnabled then continue end

		local myRoot = getTargetRoot(localPlayer)
		if not myRoot then continue end

		for player, data in pairs(espObjects) do
			local targetRoot = getTargetRoot(player)
			if targetRoot and data.distLabel then
				local dist = math.floor((myRoot.Position - targetRoot.Position).Magnitude)
				data.distLabel.Text = `{dist} studs`
			end
		end
	end
end)

-- ================== 4. HELPER FUNCTIONS ==================
local function Notify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "VANTA Mix",
            Text = text or "",
            Duration = duration or 3
        })
    end)
end

local function GetCommRemote()
    local remFolder = ReplicatedStorage:FindFirstChild("Remotes")
    if remFolder then
        return remFolder:FindFirstChild("CommF_")
    end
    return ReplicatedStorage:FindFirstChild("CommF_")
end

local function InvokeComm(...)
    local remote = GetCommRemote()
    if remote and remote:IsA("RemoteFunction") then
        local ok, res = pcall(remote.InvokeServer, remote, ...)
        if ok then return res end
    end
    return nil
end

local function CancelActiveTween()
    if Runtime.ActiveTween then
        pcall(function() Runtime.ActiveTween:Cancel() end)
        Runtime.ActiveTween = nil
    end
end

local function MoveToPosition(targetPos, directHover)
    local root = Runtime.RootPart
    local hum = Runtime.Humanoid
    if not root or not hum or hum.Health <= 0 then return end

    local dist = (root.Position - targetPos).Magnitude
    if dist < 6 then
        CancelActiveTween()
        root.CFrame = CFrame.new(targetPos)
        return
    end

    if directHover then
        CancelActiveTween()
        local duration = math.clamp(dist / Config.TweenSpeed, 0.05, 8)
        local info = TweenInfo.new(duration, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(root, info, {CFrame = CFrame.new(targetPos)})
        Runtime.ActiveTween = tween
        tween:Play()
    else
        hum:MoveTo(targetPos)
    end
end

local function GetEnemyContainer()
    return Workspace:FindFirstChild("Enemies") or Workspace:FindFirstChild("NPCs") or Workspace
end

local function GetNearestEnemy(maxRadius)
    local root = Runtime.RootPart
    if not root then return nil end

    local container = GetEnemyContainer()
    local nearest = nil
    local shortestDist = maxRadius or Config.FarmDistance

    for _, model in ipairs(container:GetChildren()) do
        if model:IsA("Model") and model ~= Runtime.Character then
            local eHum = model:FindFirstChildOfClass("Humanoid")
            local eRoot = model:FindFirstChild("HumanoidRootPart")
            if eHum and eRoot and eHum.Health > 0 then
                local dist = (root.Position - eRoot.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearest = model
                end
            end
        end
    end
    return nearest
end

local function EquipBestTool()
    local char = Runtime.Character
    local hum = Runtime.Humanoid
    if not char or not hum then return end
    if char:FindFirstChildOfClass("Tool") then return end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end

    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            if item.ToolTip == Config.StatPriority or item.Name:lower():find(Config.StatPriority:lower()) then
                hum:EquipTool(item)
                return
            end
        end
    end

    local firstTool = backpack:FindFirstChildOfClass("Tool")
    if firstTool then
        hum:EquipTool(firstTool)
    end
end

local function AttackEnemy(enemyModel)
    local root = Runtime.RootPart
    local eRoot = enemyModel and enemyModel:FindFirstChild("HumanoidRootPart")
    if not root or not eRoot then return end

    EquipBestTool()

    -- Giữ vị trí phía trên mục tiêu để tránh sát thương cận chiến
    local hoverPos = eRoot.Position + Vector3.new(0, Config.HoverHeight, 0)
    root.CFrame = CFrame.new(hoverPos, eRoot.Position)

    -- Kích hoạt click đòn đánh
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.02)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

local function TeleportToIsland(islandName)
    local targetVec = Options.Islands[islandName]
    if not targetVec then
        Notify("Teleport", "Không tìm thấy tọa độ đảo: " .. tostring(islandName), 2)
        return
    end
    Notify("Teleport", "Đang di chuyển tới: " .. islandName, 2)
    MoveToPosition(targetVec + Vector3.new(0, 15, 0), true)
end

local function AcceptQuest()
    local gui = PlayerGui:FindFirstChild("Main")
    if gui and gui:FindFirstChild("Quest") and gui.Quest.Visible then
        return -- Đã có nhiệm vụ đang chạy
    end
    InvokeComm("StartQuest", "BanditQuest1", 1)
end

local function CompleteQuest()
    -- Tự động kiểm tra tiến độ quest qua CommF_ nếu cần
end

local function AutoStats()
    local data = LocalPlayer:FindFirstChild("Data")
    local points = data and data:FindFirstChild("Points")
    if points and points.Value > 0 then
        InvokeComm("AddPoint", Config.StatPriority, 1)
    end
end

local function AutoHaki()
    local char = Runtime.Character
    if not char then return end
    if not char:FindFirstChild("HasBuso") then
        InvokeComm("Buso")
    end
end

local function AutoBuyItem()
    InvokeComm("BuyItem", Config.BuyItem)
end

local function ClearESP()
    for target, adorn in pairs(Runtime.ESPObjects) do
        if adorn and adorn.Parent then
            adorn:Destroy()
        end
        Runtime.ESPObjects[target] = nil
    end
end

local function UpdateESP()
    if not Config.ESP then
        ClearESP()
        return
    end

    local root = Runtime.RootPart
    if not root then return end

    -- Dọn các đối tượng đã biến mất
    for target, adorn in pairs(Runtime.ESPObjects) do
        if not target or not target.Parent then
            if adorn then adorn:Destroy() end
            Runtime.ESPObjects[target] = nil
        end
    end

    -- Quét người chơi khác & NPC trong vùng
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local char = plr.Character
            if not Runtime.ESPObjects[char] then
                local hl = Instance.new("Highlight")
                hl.Name = "VantaESP"
                hl.FillColor = Color3.fromRGB(0, 220, 130)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.65
                hl.Adornee = char
                hl.Parent = Runtime.ScreenGui
                Runtime.ESPObjects[char] = hl
            end
        end
    end
end

local function AutoRaidCycle()
    if Runtime.RaidBusy or not Config.AutoRaid then return end
    Runtime.RaidBusy = true
    task.spawn(function()
        pcall(function()
            InvokeComm("RaidsNpc", "Select", Config.RaidType)
            task.wait(1)
            InvokeComm("RaidsNpc", "Start")
        end)
        task.wait(6)
        Runtime.RaidBusy = false
    end)
end

local function AntiAFKPulse()
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.RightControl, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.RightControl, false, game)
    end)
end

-- ================== 5. REVERSE PATH (CLEAN UNLOAD) ==================
local function UnloadScript()
    if not Runtime.Active then return end
    Runtime.Active = false

    CancelActiveTween()
    ClearESP()

    for _, conn in ipairs(Runtime.Connections) do
        if conn and conn.Connected then
            conn:Disconnect()
        end
    end
    table.clear(Runtime.Connections)

    if Runtime.ScreenGui and Runtime.ScreenGui.Parent then
        Runtime.ScreenGui:Destroy()
    end

    Notify("VANTA Mix", "Đã gỡ toàn bộ kết nối & đóng Menu.", 3)
end

